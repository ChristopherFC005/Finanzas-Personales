# --- Server ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# --- Database (Supabase Postgres) ---
# Pooled connection (pgbouncer) — used for normal runtime queries.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection — required for Prisma migrations.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres"

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
# JWT secret from Supabase Dashboard > Project Settings > API > JWT Settings.
# Used by NestJS to verify the signature of access tokens issued by Supabase Auth.
SUPABASE_JWT_SECRET=replace-me
# Service role key — SECRET. Only used server-side for admin/storage operations
# that must bypass RLS. Never expose to the frontend, logs, or version control.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- AI Assistant ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-me
