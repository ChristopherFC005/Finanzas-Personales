# --- Server ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# --- Database (Supabase Postgres) ---
# Pooled connection (pgbouncer) — used for normal runtime queries.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection — required for Prisma migrations.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres"

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
# Tokens are verified against the project's public keys (JWKS) automatically
# when it signs with ES256/RS256 (default for new projects) — no secret needed.
# ONLY set this if your project still signs with the legacy HS256 shared secret
# (Project Settings > JWT Keys > Legacy JWT Secret). Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Service role key — SECRET. Only used server-side for admin/storage operations
# that must bypass RLS. Never expose to the frontend, logs, or version control.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- AI Assistant ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-me
